# Copy to .env and fill in your own SANDBOX/TEST credentials:
#   cp .env.example .env
#
# .env is gitignored (the .env* pattern). Never commit real keys.

# --- Stripe (Card / Apple Pay) -------------------------------------------
# Test keys live at https://dashboard.stripe.com/test/apikeys
#
# Server-only. Used exclusively in src/app/api/checkout/route.ts.
# Must start with sk_test_ — a live key would take real money.
STRIPE_SECRET_KEY=sk_test_replace_me

# Not read by any code today: we redirect straight to the Stripe-hosted
# Checkout URL, so Stripe.js never loads in the browser and no publishable
# key is needed. Listed here because it's needed the moment we adopt
# Stripe Elements or embedded Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- PayPal / Venmo ------------------------------------------------------
# Sandbox app credentials live at https://developer.paypal.com/dashboard/applications/sandbox
# The API base is hardcoded to api-m.sandbox.paypal.com in src/lib/paypal.ts.
#
# Venmo requires the sandbox BUSINESS account to be US-based with Venmo
# enabled on the app (Dashboard → your app → Features → Venmo).
#
# Server-only, both of them. We never load the PayPal JS SDK in the browser,
# so the client id does not need to be public — but NEXT_PUBLIC_PAYPAL_CLIENT_ID
# is also accepted if you already have it set that way.
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me

# --- Zelle ---------------------------------------------------------------
# No variable needed. Zelle is not an integration and has no credentials — the
# destination is a published payment address, configured per vendor as
# `zelleIdentifier` in src/lib/vendors.ts.
